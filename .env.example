# OPNsense API (System → Access → Users → your user → API keys)
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_API_KEY=changeme
OPNSENSE_API_SECRET=changeme

# true | false | path to a CA bundle
OPNSENSE_TLS_VERIFY=false
OPNSENSE_TIMEOUT=30

# How often to refresh the Vector enrichment files
SCRAPE_INTERVAL=60

# Write CSV/JSON here (mount this volume into Vector)
OUTPUT_DIR=/data

# HTTP health + Prometheus metrics + file download
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Also scrape vtnet0/igb0 → LAN/WAN names
INCLUDE_INTERFACES=true
